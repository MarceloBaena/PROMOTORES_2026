{
  "name": "@promotor/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform android",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "build:aab": "npx eas-cli build --platform android --profile production",
    "config:check": "expo config --type public",
    "validate:login": "node ./scripts/validate-login.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@promotor/config": "file:../../packages/config",
    "@promotor/types": "file:../../packages/types",
    "@promotor/ui": "file:../../packages/ui",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1"
  },
  "private": true
}
