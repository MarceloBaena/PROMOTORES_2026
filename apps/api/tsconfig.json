{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@promotor/config": ["../../packages/config/src/index.ts"],
      "@promotor/config/*": ["../../packages/config/src/*"],
      "@promotor/types": ["../../packages/types/src/index.ts"],
      "@promotor/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
