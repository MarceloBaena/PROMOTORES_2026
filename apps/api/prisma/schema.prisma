generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  SUPERVISOR
  PROMOTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
}

enum RouteStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RouteItemStatus {
  PLANNED
  COMPLETED
  SKIPPED
  CANCELLED
}

enum VisitStatus {
  pending
  in_progress
  completed
  not_completed
  canceled
}

enum SupplierExecutionStatus {
  pending
  in_progress
  completed
  skipped
}

enum PhotoType {
  checkin
  before
  after
  supplier_before
  supplier_after
  leaflet
  gondola
  display
  island
  promotional_material
  checkout
  store_extra
  occurrence_extra
}

enum SyncStatus {
  pending
  syncing
  synced
  failed
}

enum SyncType {
  INITIAL_DOWNLOAD
  CLIENTS_DOWNLOAD
  ROUTES_DOWNLOAD
  VISIT_UPLOAD
  PHOTO_UPLOAD
  OCCURRENCE_UPLOAD
  STATUS_CHECK
  REPROCESS
  CSV_IMPORT
}

enum SyncEntityType {
  VISIT
  PHOTO
  OCCURRENCE
}

enum AuditFlagType {
  GPS_MISSING
  OUTSIDE_GEOFENCE
  MISSING_REQUIRED_PHOTO
  SUPPLIER_MISSING_BEFORE_PHOTO
  SUPPLIER_MISSING_AFTER_PHOTO
  SUPPLIER_MISSING_DELIVERY_RESPONSE
  SUPPLIER_MISSING_REPLENISHMENT_RESPONSE
  SUPPLIER_MISSING_STOCKOUT_RESPONSE
  SUPPLIER_TOO_FAST
  CHECKOUT_WITH_PENDING_SUPPLIER
  TOO_FAST_VISIT
  TOO_LONG_VISIT
  INCONSISTENT_FINISH
  SYNC_FAILURE
  POSSIBLE_DUPLICATE_PHOTO
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OccurrenceType {
  store_closed
  manager_absent
  rupture
  no_stock
  price_issue
  competitor_action
  other
}

enum OccurrenceStatus {
  open
  in_review
  resolved
  rejected
}

enum ImportStatus {
  PREVIEW
  SUCCESS
  PARTIAL
  FAILED
}

model Role {
  id        String   @id @default(uuid())
  code      RoleCode @unique
  name      String
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Company {
  id            String             @id @default(uuid())
  code          Int                @unique @default(autoincrement())
  name          String
  document      String?
  contactName   String?            @map("contact_name")
  contactPhone  String?            @map("contact_phone")
  contactEmail  String?            @map("contact_email")
  address       String?
  addressNumber String?            @map("address_number")
  district      String?
  city          String?
  state         String?
  status        CompanyStatus      @default(ACTIVE)
  users         User[]
  supervisors   Supervisor[]
  promoters     Promoter[]
  clients       Client[]
  routes        Route[]
  visits        Visit[]
  locations     PromoterLocation[]
  suppliers     Supplier[]
  supplierExecutions SupplierExecution[]
  productCategories ProductCategory[]
  clientActivityTypes ClientActivityType[]
  syncLogs      SyncLog[]
  importLogs    ClientImportLog[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([name])
  @@map("companies")
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  name               String
  passwordHash       String            @map("password_hash")
  status             UserStatus        @default(ACTIVE)
  companyId          String?           @map("company_id")
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  roleId             String            @map("role_id")
  role               Role              @relation(fields: [roleId], references: [id])
  supervisor         Supervisor?
  promoter           Promoter?
  refreshTokens      RefreshToken[]
  syncLogs           SyncLog[]
  clientImportLogs   ClientImportLog[]
  resolvedAuditFlags AuditFlag[]       @relation("AuditFlagResolvedBy")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("users")
}

model Supervisor {
  id        String        @id @default(uuid())
  code      Int           @unique @default(autoincrement())
  companyId String?       @map("company_id")
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId    String        @unique @map("user_id")
  user      User          @relation(fields: [userId], references: [id])
  status    ProfileStatus @default(ACTIVE)
  region    String?
  promoters Promoter[]
  routes    Route[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("supervisors")
}

model Promoter {
  id           String             @id @default(uuid())
  code         Int                @unique @default(autoincrement())
  companyId    String?            @map("company_id")
  company      Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId       String             @unique @map("user_id")
  user         User               @relation(fields: [userId], references: [id])
  supervisorId String?            @map("supervisor_id")
  supervisor   Supervisor?        @relation(fields: [supervisorId], references: [id])
  status       ProfileStatus      @default(ACTIVE)
  phone        String?
  routes       Route[]
  visits       Visit[]
  locations    PromoterLocation[]
  clients      Client[]
  supplierExecutions SupplierExecution[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, status])
  @@map("promoters")
}

model Client {
  id                   String       @id @default(uuid())
  code                 String?
  companyId            String?      @map("company_id")
  company              Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name                 String
  document             String?
  representative       String?
  status               ClientStatus @default(ACTIVE)
  address              String?
  addressNumber        String?      @map("address_number")
  district             String?
  city                 String?
  state                String?
  latitude             Decimal?     @db.Decimal(10, 7)
  longitude            Decimal?     @db.Decimal(10, 7)
  geofenceRadiusMeters Int          @default(150) @map("geofence_radius_m")
  defaultPromoterId    String?      @map("default_promoter_id")
  defaultPromoter      Promoter?    @relation(fields: [defaultPromoterId], references: [id], onDelete: SetNull)
  suppliers            ClientSupplier[]
  activities           ClientActivityAssignment[]
  routeItems           RouteItem[]
  visits               Visit[]
  supplierExecutions   SupplierExecution[]
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([name])
  @@index([companyId])
  @@index([companyId, defaultPromoterId, status])
  @@map("clients")
}

model Supplier {
  id          String           @id @default(uuid())
  companyId   String?          @map("company_id")
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  tradeName   String?          @map("trade_name")
  document    String?
  email       String?
  phone       String?
  contactName String?          @map("contact_name")
  notes       String?
  status      SupplierStatus   @default(ACTIVE)
  clients     ClientSupplier[]
  categories  SupplierProductCategory[]
  supplierExecutions SupplierExecution[]
  photos      VisitPhoto[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, status])
  @@index([name])
  @@map("suppliers")
}

model ProductCategory {
  id          String                    @id @default(uuid())
  code        Int                       @unique @default(autoincrement())
  companyId   String?                   @map("company_id")
  company     Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      CategoryStatus            @default(ACTIVE)
  suppliers   SupplierProductCategory[]
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, status])
  @@index([name])
  @@map("product_categories")
}

model ClientActivityType {
  id          String                   @id @default(uuid())
  code        Int                      @unique @default(autoincrement())
  companyId   String?                  @map("company_id")
  company     Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      ActivityStatus           @default(ACTIVE)
  clients     ClientActivityAssignment[]
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, status])
  @@index([name])
  @@map("client_activity_types")
}

model SupplierProductCategory {
  id         String          @id @default(uuid())
  supplierId String          @map("supplier_id")
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String          @map("category_id")
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@unique([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_product_categories")
}

model ClientSupplier {
  id         String   @id @default(uuid())
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([clientId, supplierId])
  @@index([supplierId])
  @@map("client_suppliers")
}

model ClientActivityAssignment {
  id         String             @id @default(uuid())
  clientId   String             @map("client_id")
  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activityId String             @map("activity_id")
  activity   ClientActivityType @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([clientId, activityId])
  @@index([activityId])
  @@map("client_activity_assignments")
}

model Route {
  id            String      @id @default(uuid())
  companyId     String?     @map("company_id")
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name          String
  status        RouteStatus @default(DRAFT)
  scheduledDate DateTime?   @map("scheduled_date")
  startDate     DateTime?   @map("start_date")
  endDate       DateTime?   @map("end_date")
  supervisorId  String?     @map("supervisor_id")
  supervisor    Supervisor? @relation(fields: [supervisorId], references: [id])
  promoterId    String?     @map("promoter_id")
  promoter      Promoter?   @relation(fields: [promoterId], references: [id])
  items         RouteItem[]
  visits        Visit[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, promoterId, status, scheduledDate])
  @@index([companyId, promoterId, status, startDate, endDate])
  @@map("routes")
}

model RouteItem {
  id           String          @id @default(uuid())
  routeId      String          @map("route_id")
  route        Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  clientId     String          @map("client_id")
  client       Client          @relation(fields: [clientId], references: [id])
  sequence     Int
  status       RouteItemStatus @default(PLANNED)
  plannedStart DateTime?       @map("planned_start")
  plannedEnd   DateTime?       @map("planned_end")
  visits       Visit[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([routeId, sequence])
  @@index([routeId, clientId])
  @@map("route_items")
}

model Visit {
  id                       String             @id @default(uuid())
  clientGeneratedId        String?            @unique @map("client_generated_id")
  companyId                String?            @map("company_id")
  company                  Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  routeId                  String?            @map("route_id")
  route                    Route?             @relation(fields: [routeId], references: [id])
  routeItemId              String?            @map("route_item_id")
  routeItem                RouteItem?         @relation(fields: [routeItemId], references: [id])
  clientId                 String             @map("client_id")
  client                   Client             @relation(fields: [clientId], references: [id])
  promoterId               String?            @map("promoter_id")
  promoter                 Promoter?          @relation(fields: [promoterId], references: [id])
  status                   VisitStatus        @default(pending)
  startedAt                DateTime?          @map("started_at")
  finishedAt               DateTime?          @map("finished_at")
  gpsLatitude              Decimal?           @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude             Decimal?           @map("gps_longitude") @db.Decimal(10, 7)
  gpsAccuracyMeters        Decimal?           @map("gps_accuracy_meters") @db.Decimal(10, 2)
  locationPermissionStatus String?            @map("location_permission_status")
  notes                    String?
  supplierExecutions       SupplierExecution[]
  photos                   VisitPhoto[]
  occurrences              VisitOccurrence[]
  auditFlags               AuditFlag[]
  locations                PromoterLocation[]
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("visits")
}

model SupplierExecution {
  id                   String                  @id @default(uuid())
  clientGeneratedId    String?                 @unique @map("client_generated_id")
  companyId            String?                 @map("company_id")
  company              Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  visitId              String                  @map("visit_id")
  visit                Visit                   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  supplierId           String                  @map("supplier_id")
  supplier             Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  clientId             String                  @map("client_id")
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  promoterId           String?                 @map("promoter_id")
  promoter             Promoter?               @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  status               SupplierExecutionStatus @default(pending)
  deliveryReceived     Boolean?                @map("delivery_received")
  productsReplenished  Boolean?                @map("products_replenished")
  stockoutFound        Boolean?                @map("stockout_found")
  notes                String?
  beforePhotoId        String?                 @map("before_photo_id")
  afterPhotoId         String?                 @map("after_photo_id")
  startedAtDevice      DateTime?               @map("started_at_device")
  finishedAtDevice     DateTime?               @map("finished_at_device")
  syncStatus           SyncStatus              @default(pending) @map("sync_status")
  photos               VisitPhoto[]
  products             SupplierExecutionProduct[]
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([visitId, status])
  @@index([clientId, supplierId])
  @@map("supplier_executions")
}

model SupplierExecutionProduct {
  id                    String             @id @default(uuid())
  supplierExecutionId   String             @map("supplier_execution_id")
  supplierExecution     SupplierExecution  @relation(fields: [supplierExecutionId], references: [id], onDelete: Cascade)
  productId             String?            @map("product_id")
  stockQuantity         Decimal?           @map("stock_quantity") @db.Decimal(12, 2)
  facing                Int?
  rupture               Boolean?
  price                 Decimal?           @db.Decimal(12, 2)
  promotion             Boolean?
  notes                 String?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([supplierExecutionId])
  @@map("supplier_execution_products")
}

model PromoterLocation {
  id             String   @id @default(uuid())
  companyId      String?  @map("company_id")
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  promoterId     String   @map("promoter_id")
  promoter       Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  visitId        String?  @map("visit_id")
  visit          Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  accuracyMeters Decimal? @map("accuracy_meters") @db.Decimal(10, 2)
  capturedAt     DateTime @map("captured_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  source         String   @default("mobile")

  @@index([promoterId, capturedAt])
  @@index([visitId])
  @@index([companyId])
  @@map("promoter_locations")
}

model VisitPhoto {
  id                String    @id @default(uuid())
  clientGeneratedId String?   @unique @map("client_generated_id")
  visitId           String    @map("visit_id")
  visit             Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  supplierExecutionId String? @map("supplier_execution_id")
  supplierExecution SupplierExecution? @relation(fields: [supplierExecutionId], references: [id], onDelete: SetNull)
  supplierId       String?    @map("supplier_id")
  supplier         Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  type              PhotoType
  url               String
  storageKey        String?   @map("storage_key")
  capturedAtDevice  DateTime? @map("captured_at_device")
  syncStatus        SyncStatus @default(pending) @map("sync_status")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([supplierExecutionId])
  @@index([supplierId])
  @@map("visit_photos")
}

model VisitOccurrence {
  id             String           @id @default(uuid())
  visitId        String           @map("visit_id")
  visit          Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type           OccurrenceType   @default(other)
  status         OccurrenceStatus @default(open)
  description    String
  resolutionNote String?          @map("resolution_note")
  metadata       Json?
  viewedAt       DateTime?        @map("viewed_at")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("visit_occurrences")
}

model SyncLog {
  id         String          @id @default(uuid())
  companyId  String?         @map("company_id")
  company    Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  type       SyncType
  status     SyncStatus      @default(pending)
  userId     String?         @map("user_id")
  user       User?           @relation(fields: [userId], references: [id])
  entityType SyncEntityType? @map("entity_type")
  entityId   String?         @map("entity_id")
  summary    Json?
  error      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("sync_logs")
}

model SyncTracking {
  id            String         @id @default(uuid())
  entityType    SyncEntityType @map("entity_type")
  entityId      String         @map("entity_id")
  status        SyncStatus     @default(pending)
  attempts      Int            @default(0)
  lastAttemptAt DateTime?      @map("last_attempt_at")
  syncedAt      DateTime?      @map("synced_at")
  payload       Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@map("sync_trackings")
}

model AuditFlag {
  id             String        @id @default(uuid())
  visitId        String        @map("visit_id")
  visit          Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type           AuditFlagType
  severity       AuditSeverity @default(MEDIUM)
  description    String?
  details        Json?
  resolved       Boolean       @default(false)
  resolvedById   String?       @map("resolved_by")
  resolvedBy     User?         @relation("AuditFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?     @map("resolved_at")
  resolutionNote String?       @map("resolution_note")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([resolved])
  @@index([resolvedById])
  @@map("audit_flags")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model ClientImportLog {
  id           String       @id @default(uuid())
  companyId    String?      @map("company_id")
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  fileName     String       @map("file_name")
  status       ImportStatus @default(PREVIEW)
  totalRows    Int          @default(0) @map("total_rows")
  importedRows Int          @default(0) @map("imported_rows")
  failedRows   Int          @default(0) @map("failed_rows")
  preview      Json?
  errors       Json?
  createdById  String?      @map("created_by_id")
  createdBy    User?        @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([companyId])
  @@map("client_import_logs")
}
