{
  "name": "@sales-promoters/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:shared": "node -e \"const fs=require('fs');const cp=require('child_process');const path='../../packages/shared';if(fs.existsSync(path)){cp.execSync('npm run build',{cwd:path,stdio:'inherit'});}else{console.log('Pacote shared nao encontrado fora da API; usando dependencia instalada.');}\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:shared && prisma generate && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "test:database-url": "node --import tsx --test src/config/database-url.test.ts",
    "seed:access": "tsx src/scripts/bootstrap.ts",
    "check:tenant": "tsx src/scripts/tenant-scope-check.ts",
    "supabase:check": "tsx src/scripts/supabase-check.ts",
    "supabase:setup": "tsx src/scripts/supabase-setup.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sales-promoters/shared": "file:../../packages/shared",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
